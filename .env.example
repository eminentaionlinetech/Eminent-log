# EMINENT LOG — environment variables
# Copy to `.env` for local development. NEVER commit real secrets.
# Server-only values (no VITE_ prefix) must never be exposed to the browser.

# --- Supabase / PostgreSQL (browser-safe, bundled at build time) ---
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Supabase (server-only) ---
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="your-project-ref"
# Bypasses Row-Level Security. Used only inside server functions/routes.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Database migrations (Drizzle; used by drizzle.config.ts) ---
LOVABLE_DB_MIGRATION_URL="postgresql://postgres:CHANGE_ME@db.your-project-ref.supabase.co:5432/postgres"

# --- Korapay payments ---
# Secret key (server-only): used to initialize charges, verify them and
# check webhook signatures. Use sk_test_... in staging, sk_live_... in production.
KORAPAY_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Public key (browser-safe). Reserved for an inline checkout widget; the
# current redirect checkout does not require it.
VITE_KORAPAY_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Application ---
# Canonical public URL. Checkout redirect and webhook URLs are currently
# derived from the incoming request origin; set this for documentation,
# SEO tooling and future absolute-link generation.
APP_BASE_URL="https://your-domain.example"
